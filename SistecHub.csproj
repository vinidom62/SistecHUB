<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SistecHub</RootNamespace>
    <AssemblyName>SistecHub</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.1.8</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="DiskInfoToolkit" Version="1.1.2" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="Velopack" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="ThirdParty\PawnIO\PawnIO_setup.exe"
          Link="PawnIO_setup.exe"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('ThirdParty\PawnIO\PawnIO_setup.exe')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SistecHub.Service\**" />
    <EmbeddedResource Remove="SistecHub.Service\**" />
    <None Remove="SistecHub.Service\**" />
    <Compile Remove="SistecHub.ServiceSetup\**" />
    <EmbeddedResource Remove="SistecHub.ServiceSetup\**" />
    <None Remove="SistecHub.ServiceSetup\**" />
  </ItemGroup>

</Project>
