    <Compile Include="..\Core\ServiceLogWriter.cs" Link="Shared\ServiceLogWriter.cs" />
    <Compile Include="..\Core\SistecHubAppProcess.cs" Link="Shared\SistecHubAppProcess.cs" />
    <Compile Include="..\Core\UpdateServiceCoordinator.cs" Link="Shared\UpdateServiceCoordinator.cs" />
    <Compile Include="..\Core\InventarioServiceCoordinator.cs" Link="Shared\InventarioServiceCoordinator.cs" />
    <Compile Include="..\Core\PawnIoInstaller.cs" Link="Shared\PawnIoInstaller.cs" />
    <Compile Include="..\Core\UpdateActivityLog.cs" Link="Shared\UpdateActivityLog.cs" />
