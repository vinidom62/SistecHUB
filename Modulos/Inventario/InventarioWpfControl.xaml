<UserControl x:Class="SistecHub.Modulos.Inventario.InventarioWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Theme.PageBg}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Card Interativo de Cabeçalho (Estação de Trabalho) -->
        <Style x:Key="InteractiveHeaderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão Integrado de Atualização no Cabeçalho -->
        <Style x:Key="HeaderRefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextHeading}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.IndigoSoftBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.IndigoSoftBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.IndigoHoverBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.BorderSubtle}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Compacto de Ícone (Chave de Ativação) -->
        <Style x:Key="OsKeyActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.StrongBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.PressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Padrão Branco Elevado -->
        <Style x:Key="ElevatedCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" BlurRadius="10" ShadowDepth="1.5" Direction="270" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card de Hardware Individual -->
        <Style x:Key="HardwareCardBorderStyle" TargetType="Border" BasedOn="{StaticResource ElevatedCardBorderStyle}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <!-- Row 0: Cabeçalho -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Banner do Sistema Operacional -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: 4 Cards de Hardware (Processador, RAM, GPU, Placa mãe) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Seção de Discos -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Cabeçalho Superior -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Inventário de Hardware"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Theme.IndigoSoftBg}"
                            CornerRadius="6"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="DIAGNÓSTICO DO SISTEMA"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.IndigoText}"/>
                    </Border>
                </StackPanel>

                <Border Width="48"
                        Height="4"
                        CornerRadius="2"
                        Background="#6366F1"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"/>

                <TextBlock Text="Especificações dos componentes físicos, armazenamento e integridade operacional desta estação."
                           FontSize="13"
                           Foreground="{DynamicResource Theme.TextMuted}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <!-- Card 1: Estação de Trabalho com Hostname (Clique para copiar) -->
                <Border x:Name="CardMachineHostname"
                        Style="{StaticResource InteractiveHeaderCardStyle}"
                        Height="44"
                        Padding="10,0,12,0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        ToolTip="Clique para copiar o nome desta estação (Hostname)"
                        MouseDown="CardMachineHostname_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28"
                                CornerRadius="7"
                                Background="{DynamicResource Theme.IndigoSoftBg}"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE7EE;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource Theme.IndigoText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ESTAÇÃO DE TRABALHO"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.TextMuted}"
                                       Margin="0,0,0,1"/>
                            <TextBlock x:Name="TxtMachineHostname"
                                       Text="ESTAÇÃO LOCAL"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.TextPrimary}"/>
                        </StackPanel>
                        <TextBlock x:Name="IconCopyHostname"
                                   Text="&#xE8C8;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.TextSubtle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Status de Sincronização & Botão Atualizar Integrado -->
                <Border Background="{DynamicResource Theme.CardBg}"
                        BorderBrush="{DynamicResource Theme.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="44"
                        Padding="12,0,6,0"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Ponto Luminoso de Status -->
                        <Border x:Name="StatusDotContainer"
                                Width="8" Height="8"
                                CornerRadius="4"
                                Background="#10B981"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"/>

                        <!-- Textos de Status -->
                        <StackPanel VerticalAlignment="Center" MinWidth="105">
                            <TextBlock x:Name="TxtStatusCategory"
                                       Text="ÚLTIMA SINCRONIZAÇÃO"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.TextMuted}"
                                       Margin="0,0,0,1"/>
                            <TextBlock x:Name="TxtLastUpdate"
                                       Text="Carregando…"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextHeading}"/>
                        </StackPanel>

                        <!-- Divisor vertical discreto -->
                        <Border Width="1"
                                Height="22"
                                Background="{DynamicResource Theme.StrongBg}"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center"/>

                        <!-- Botão Atualizar com animação de giro contínuo -->
                        <Button x:Name="BtnRefresh"
                                Style="{StaticResource HeaderRefreshButtonStyle}"
                                Height="32"
                                Padding="10,0"
                                ToolTip="Atualizar informações de inventário"
                                Click="BtnRefresh_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="IconRefresh"
                                           Text="&#xE72C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           RenderTransformOrigin="0.5,0.5"
                                           VerticalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="RefreshRotateTransform" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="TxtRefreshBtnLabel"
                                           Text="Atualizar"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Row 1: Banner do Sistema Operacional -->
        <Border Grid.Row="1"
                Style="{StaticResource ElevatedCardBorderStyle}"
                Margin="0,0,0,18"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Esquerda: Logo Windows + Nome do SO + Versão -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Grid Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="9"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="9"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="#0078D7" RadiusX="1" RadiusY="1"/>
                        <Rectangle Grid.Row="0" Grid.Column="2" Fill="#0078D7" RadiusX="1" RadiusY="1"/>
                        <Rectangle Grid.Row="2" Grid.Column="0" Fill="#0078D7" RadiusX="1" RadiusY="1"/>
                        <Rectangle Grid.Row="2" Grid.Column="2" Fill="#0078D7" RadiusX="1" RadiusY="1"/>
                    </Grid>

                    <TextBlock x:Name="TxtOsName"
                               Text="Windows"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBlock x:Name="TxtOsVersion"
                               Text=""
                               FontSize="12.5"
                               Foreground="{DynamicResource Theme.TextMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Direita: Status de Ativação + Chave + Botões Revelar/Copiar -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="BdOsStatus"
                            Background="{DynamicResource Theme.SubtleBg}"
                            CornerRadius="6"
                            MinHeight="32"
                            Padding="10,0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel x:Name="SpOsStatus"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Path x:Name="PathOsStatusIcon"
                                  Width="12"
                                  Height="12"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtOsStatus"
                                       Text="—"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.TextMuted}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="None"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Container para Chave de Ativação -->
                    <Border x:Name="BdOsKey"
                            Background="{DynamicResource Theme.SurfaceBg}"
                            BorderBrush="{DynamicResource Theme.BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel x:Name="SpOsKey"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="TxtOsKey"
                                       Text=""
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0"
                                       Cursor="Hand"
                                       Visibility="Collapsed"
                                       MouseLeftButtonUp="TxtOsKey_MouseLeftButtonUp"/>

                            <Button x:Name="BtnRevealKey"
                                    Style="{StaticResource OsKeyActionButtonStyle}"
                                    Margin="0,0,4,0"
                                    Visibility="Collapsed"
                                    Click="BtnRevealKey_Click">
                                <TextBlock x:Name="TxtRevealKeyGlyph"
                                           Text="&#xE72E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource Theme.TextBody}"/>
                            </Button>

                            <Button x:Name="BtnCopyKey"
                                    Style="{StaticResource OsKeyActionButtonStyle}"
                                    Visibility="Collapsed"
                                    ToolTip="Copiar chave de ativação"
                                    Click="BtnCopyKey_Click">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource Theme.TextBody}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: 4 Cards de Hardware (Processador, RAM, GPU, Placa mãe) -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,22">
            <!-- Card 0: Processador -->
            <Border Style="{StaticResource HardwareCardBorderStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Topo: Ícone + Categoria -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="10"
                                Background="{DynamicResource Theme.IndigoSoftBg}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE950;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="{DynamicResource Theme.IndigoText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Theme.SubtleBg}"
                                CornerRadius="6"
                                Padding="7,2.5">
                            <TextBlock Text="PROCESSADOR"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.TextMuted}"/>
                        </Border>
                    </Grid>

                    <!-- Valor Principal -->
                    <TextBlock Grid.Row="1"
                               x:Name="TxtCpuValue"
                               Text="A carregar…"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <!-- Telemetria Secundária -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource Theme.SurfaceBg}"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtCpuSecondary"
                                   Text="A carregar…"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextBody}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 1: Memória RAM -->
            <Border Style="{StaticResource HardwareCardBorderStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="10"
                                Background="{DynamicResource Theme.SuccessSoftBg}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE9F5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="{DynamicResource Theme.SuccessText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Theme.SubtleBg}"
                                CornerRadius="6"
                                Padding="7,2.5">
                            <TextBlock Text="MEMÓRIA RAM"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.TextMuted}"/>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               x:Name="TxtRamValue"
                               Text="A carregar…"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <Border Grid.Row="2"
                            Background="{DynamicResource Theme.SurfaceBg}"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtRamSecondary"
                                   Text="A carregar…"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextBody}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Placa de vídeo -->
            <Border Style="{StaticResource HardwareCardBorderStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="10"
                                Background="{DynamicResource Theme.PurpleSoftBg}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE714;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="{DynamicResource Theme.PurpleText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Theme.SubtleBg}"
                                CornerRadius="6"
                                Padding="7,2.5">
                            <TextBlock Text="PLACA DE VÍDEO"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.TextMuted}"/>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               x:Name="TxtGpuValue"
                               Text="A carregar…"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <Border Grid.Row="2"
                            Background="{DynamicResource Theme.SurfaceBg}"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtGpuSecondary"
                                   Text="A carregar…"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextBody}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Placa mãe -->
            <Border Style="{StaticResource HardwareCardBorderStyle}" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="10"
                                Background="{DynamicResource Theme.WarningSoftBg}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE770;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="{DynamicResource Theme.WarningText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Theme.SubtleBg}"
                                CornerRadius="6"
                                Padding="7,2.5">
                            <TextBlock Text="PLACA MÃE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.TextMuted}"/>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               x:Name="TxtMotherboardValue"
                               Text="A carregar…"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <Border Grid.Row="2"
                            Background="{DynamicResource Theme.SurfaceBg}"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtMotherboardSecondary"
                                   Text="A carregar…"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextBody}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Row 3: Seção de Unidades de Armazenamento (Discos) -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho da Seção de Discos -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,12">
                <TextBlock Text="Unidades de Armazenamento"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <Border x:Name="DiskInfoTrigger"
                        Background="{DynamicResource Theme.SubtleBg}"
                        CornerRadius="6"
                        Padding="6,3"
                        Cursor="Help"
                        VerticalAlignment="Center"
                        MouseEnter="DiskInfoTrigger_MouseEnter"
                        MouseLeave="DiskInfoTrigger_MouseLeave">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDiskInfoIcon"
                                   Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock Text="Saúde SMART"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Lista Horizontal de Cartões de Discos -->
            <ScrollViewer x:Name="DisksScrollViewer"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="DisksScrollViewer_PreviewMouseWheel">
                <StackPanel x:Name="DisksStackPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="0,0,8,6"/>
            </ScrollViewer>

            <!-- Card Flutuante de Explicação SMART -->
            <Border x:Name="DiskHealthHintCard"
                    Grid.Row="1"
                    Width="330"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"
                    Background="{DynamicResource Theme.CardBg}"
                    BorderBrush="{DynamicResource Theme.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed"
                    Panel.ZIndex="20"
                    MouseEnter="DiskHealthHintCard_MouseEnter"
                    MouseLeave="DiskHealthHintCard_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.12"/>
                </Border.Effect>
                <Grid>
                    <Border Width="4"
                            Background="#6366F1"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,10"
                            CornerRadius="2"/>
                    <StackPanel Margin="18,14,16,14">
                        <TextBlock Text="Diagnóstico de Saúde e Vida Útil"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextPrimary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Os indicadores de integridade e vida útil restante são lidos através dos telemetrias SMART e firmware dos fabricantes. Indicam o desgaste físico das células de memória e servem como alerta preventivo para troca antes de perda de dados."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
