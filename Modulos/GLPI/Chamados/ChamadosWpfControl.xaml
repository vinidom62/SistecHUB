<UserControl x:Class="SistecHub.Modulos.GLPI.Chamados.ChamadosWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Theme.PageBg}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Estilização Moderna e Elegante da Barra de Rolagem (Scrollbar) -->
        <Style x:Key="ScrollRepeatTransparent" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource Theme.PressedBg}"
                                CornerRadius="3.5"
                                Margin="1,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollRepeatTransparent}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollRepeatTransparent}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollRepeatTransparent}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollRepeatTransparent}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão Integrado de Atualização no Cabeçalho -->
        <Style x:Key="HeaderRefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextHeading}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.IndigoSoftBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.IndigoSoftBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.IndigoHoverBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.BorderSubtle}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Primário Verde (+ Abrir novo chamado) -->
        <Style x:Key="GreenActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#16A34A" BlurRadius="8" ShadowDepth="1.5" Direction="270" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#166534"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card de Status / Métricas -->
        <Style x:Key="MetricCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Secundário Contorno (Paginação) -->
        <Style x:Key="OutlineRoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextHeading}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SubtleBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,2,0,0">
        <Grid.RowDefinitions>
            <!-- Row 0: Barra Superior: Entidade + Atualização -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: 5 Cards de Status / Métricas -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Divisor + Cabeçalho "Meus chamados" + Botão "+ Abrir chamado" -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Lista de Chamados (Scrollable) -->
            <RowDefinition Height="*"/>
            <!-- Row 4: Barra de Paginação -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Barra Superior: Entidade (esquerda) e Atualização (direita) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Lado Esquerdo: Card da Entidade / Empresa GLPI -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Theme.CardBg}"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="44"
                    Padding="10,0,14,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            CornerRadius="7"
                            Background="{DynamicResource Theme.IndigoSoftBg}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource Theme.IndigoText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EMPRESA / ENTIDADE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   Margin="0,0,0,1"/>
                        <TextBlock x:Name="TxtEntityName"
                                   Text="A consultar o GLPI…"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextPrimary}"
                                   MaxWidth="420"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Lado Direito: Status de Sincronização & Botão Atualizar Integrado -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Theme.CardBg}"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="44"
                    Padding="12,0,6,0"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Ponto Luminoso de Status -->
                    <Border x:Name="StatusDotContainer"
                            Width="8" Height="8"
                            CornerRadius="4"
                            Background="#10B981"
                            Margin="0,0,9,0"
                            VerticalAlignment="Center"/>

                    <!-- Textos de Status -->
                    <StackPanel VerticalAlignment="Center" MinWidth="105">
                        <TextBlock x:Name="TxtStatusCategory"
                                   Text="ÚLTIMA SINCRONIZAÇÃO"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   Margin="0,0,0,1"/>
                        <TextBlock x:Name="TxtLastUpdate"
                                   Text="Aguardando…"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextHeading}"/>
                    </StackPanel>

                    <!-- Divisor vertical discreto -->
                    <Border Width="1"
                            Height="22"
                            Background="{DynamicResource Theme.StrongBg}"
                            Margin="12,0,8,0"
                            VerticalAlignment="Center"/>

                    <!-- Botão Atualizar com animação de giro contínuo -->
                    <Button x:Name="BtnRefresh"
                            Style="{StaticResource HeaderRefreshButtonStyle}"
                            Height="32"
                            Padding="10,0"
                            ToolTip="Atualizar chamados agora"
                            Click="BtnRefresh_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IconRefresh"
                                       Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       RenderTransformOrigin="0.5,0.5"
                                       VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="RefreshRotateTransform" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="TxtRefreshBtnLabel"
                                       Text="Atualizar"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 1: 5 Cards de Status / Métricas -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <!-- Card 0: Chamados novos -->
            <Border Style="{StaticResource MetricCardBorderStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="NOVOS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Width="26" Height="26"
                                CornerRadius="6"
                                Background="{DynamicResource Theme.SuccessSoftBg}">
                            <TextBlock Text="&#xE734;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.SuccessText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,6,0,0">
                        <TextBlock x:Name="ValNovos"
                                   Text="…"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.SuccessText}"
                                   Margin="0,0,0,2"/>
                        <Border Height="3" Width="26"
                                CornerRadius="1.5"
                                Background="#16A34A"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 1: Chamados pendentes -->
            <Border Style="{StaticResource MetricCardBorderStyle}" Margin="2,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="PENDENTES"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Width="26" Height="26"
                                CornerRadius="6"
                                Background="{DynamicResource Theme.WarningSoftBg}">
                            <TextBlock Text="&#xE823;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.WarningText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,6,0,0">
                        <TextBlock x:Name="ValPendentes"
                                   Text="…"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.WarningText}"
                                   Margin="0,0,0,2"/>
                        <Border Height="3" Width="26"
                                CornerRadius="1.5"
                                Background="#D97706"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Em atendimento -->
            <Border Style="{StaticResource MetricCardBorderStyle}" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="EM ATENDIMENTO"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Width="26" Height="26"
                                CornerRadius="6"
                                Background="{DynamicResource Theme.BlueSoftBg}">
                            <TextBlock Text="&#xE7EE;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.BlueText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,6,0,0">
                        <TextBlock x:Name="ValAtribuidos"
                                   Text="…"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.BlueText}"
                                   Margin="0,0,0,2"/>
                        <Border Height="3" Width="26"
                                CornerRadius="1.5"
                                Background="#2563EB"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Chamados pausados -->
            <Border Style="{StaticResource MetricCardBorderStyle}" Margin="6,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="PAUSADOS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Width="26" Height="26"
                                CornerRadius="6"
                                Background="{DynamicResource Theme.IndigoSoftBg}">
                            <TextBlock Text="&#xE769;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.PurpleText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,6,0,0">
                        <TextBlock x:Name="ValPausados"
                                   Text="…"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.PurpleText}"
                                   Margin="0,0,0,2"/>
                        <Border Height="3" Width="26"
                                CornerRadius="1.5"
                                Background="#7C3AED"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: Chamados fechados -->
            <Border Style="{StaticResource MetricCardBorderStyle}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="FECHADOS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Width="26" Height="26"
                                CornerRadius="6"
                                Background="{DynamicResource Theme.SubtleBg}">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.TextBody}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,6,0,0">
                        <TextBlock x:Name="ValFechados"
                                   Text="…"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextBody}"
                                   Margin="0,0,0,2"/>
                        <Border Height="3" Width="26"
                                CornerRadius="1.5"
                                Background="#475569"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Row 2: Divisor + Cabeçalho "Meus chamados" + Botão "+ Abrir chamado" -->
        <StackPanel Grid.Row="2" Margin="0,4,0,0">
            <Border Height="1" Background="{DynamicResource Theme.StrongBg}" Margin="0,0,0,16"/>

            <Grid MinHeight="42" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="&#xE8BD;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="{DynamicResource Theme.IndigoText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Meus chamados"
                                   FontSize="18.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Acompanhe o andamento dos tickets de suporte e solicitações desta empresa."
                               FontSize="12.5"
                               Foreground="{DynamicResource Theme.TextMuted}"/>
                </StackPanel>

                <Button x:Name="BtnOpenNewTicket"
                        Grid.Column="1"
                        Style="{StaticResource GreenActionButtonStyle}"
                        Click="BtnOpenNewTicket_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Abrir novo chamado"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Row 3: Lista de Chamados Recentes -->
        <Grid Grid.Row="3" Margin="0,4,0,4">
            <!-- Estado Vazio -->
            <Border x:Name="TxtEmptyTickets"
                    Background="{DynamicResource Theme.CardBg}"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32"
                    Margin="0,8,0,0"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="52" Height="52"
                            CornerRadius="26"
                            Background="{DynamicResource Theme.SubtleBg}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <TextBlock Text="&#xE8BD;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="{DynamicResource Theme.TextSubtle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nenhum chamado encontrado"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.TextHeading}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Não há tickets registrados no momento para esta entidade."
                               FontSize="13"
                               Foreground="{DynamicResource Theme.TextMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="TicketsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ItemsControl x:Name="TicketsItemsControl" Margin="0,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder"
                                    Height="58"
                                    Margin="0,0,0,8"
                                    Padding="14,0,16,0"
                                    Background="{DynamicResource Theme.CardBg}"
                                    BorderBrush="{DynamicResource Theme.BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.02"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Badge do ID -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource Theme.SubtleBg}"
                                            CornerRadius="6"
                                            Padding="9,4"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IdDisplay}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Theme.TextBody}"/>
                                    </Border>

                                    <!-- Título do Chamado -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TitleDisplay}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.TextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,16,0"/>

                                    <!-- Badge Pílula de Status -->
                                    <Border Grid.Column="2"
                                            Background="{Binding BadgeBackground}"
                                            CornerRadius="12"
                                            MinWidth="96"
                                            Height="25"
                                            Padding="14,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Row 4: Paginação -->
        <Grid x:Name="PaginationPanel"
              Grid.Row="4"
              Height="44"
              Margin="0,8,0,0"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnPrevPage"
                    Grid.Column="0"
                    Style="{StaticResource OutlineRoundedButtonStyle}"
                    Height="34"
                    Padding="14,0"
                    FontSize="12.5"
                    Click="BtnPrevPage_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Anterior"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Border Grid.Column="1"
                    Background="{DynamicResource Theme.CardBg}"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock x:Name="TxtPageInfo"
                           Text=""
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextBody}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <Button x:Name="BtnNextPage"
                    Grid.Column="2"
                    Style="{StaticResource OutlineRoundedButtonStyle}"
                    Height="34"
                    Padding="14,0"
                    FontSize="12.5"
                    Click="BtnNextPage_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Próxima"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE72A;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
