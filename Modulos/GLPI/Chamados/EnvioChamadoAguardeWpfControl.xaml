<UserControl x:Class="SistecHub.Modulos.GLPI.Chamados.EnvioChamadoAguardeWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Theme.PageBg}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtStatus"
                   Grid.Row="0"
                   Text="A preparar…"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Theme.TextPrimary}"
                   Margin="0,0,0,12"/>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="4"
                     Foreground="#6366F1"
                     Background="{DynamicResource Theme.StrongBg}"
                     BorderThickness="0"/>
    </Grid>
</UserControl>

