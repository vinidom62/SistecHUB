<UserControl x:Class="SistecHub.Modulos.GLPI.GlpiHeaderWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="SubmoduleNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="32,22,32,8">
        <!-- Título principal com badge -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Central de Chamados"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"/>
            <Border Background="#EEF2FF"
                    CornerRadius="6"
                    Padding="8,2"
                    VerticalAlignment="Center">
                <TextBlock Text="SUPORTE &amp; ATENDIMENTO"
                           FontSize="10.5"
                           FontWeight="Bold"
                           Foreground="#4F46E5"/>
            </Border>
        </StackPanel>

        <!-- Barra de destaque Indigo -->
        <Border Width="56"
                Height="4"
                CornerRadius="2"
                Background="#6366F1"
                HorizontalAlignment="Left"
                Margin="0,0,0,16"/>

        <!-- Botões de navegação de submódulos -->
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnNavChamados"
                    Style="{StaticResource SubmoduleNavButtonStyle}"
                    Margin="0,0,8,0"
                    Click="BtnNavChamados_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8BD;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13.5"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Chamados"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnNavAbertura"
                    Style="{StaticResource SubmoduleNavButtonStyle}"
                    Click="BtnNavAbertura_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Abertura de chamado"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
