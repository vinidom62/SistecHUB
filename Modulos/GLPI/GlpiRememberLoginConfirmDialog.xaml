<Window x:Class="SistecHub.Modulos.GLPI.GlpiRememberLoginConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviso de Segurança"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{DynamicResource Theme.CardBg}"
            BorderBrush="{DynamicResource Theme.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28,24"
            Margin="12"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.14"/>
        </Border.Effect>

        <StackPanel>
            <!-- Topo: Ícone + Título -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.WarningSoftBg}"
                        BorderBrush="{DynamicResource Theme.WarningSoftBorder}"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource Theme.WarningText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Salvar Login na Máquina"
                               FontSize="16.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="Confirmação de responsabilidade e auditoria"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.TextMuted}"/>
                </StackPanel>
            </Grid>

            <!-- Mensagem Exata Solicitada -->
            <Border Background="{DynamicResource Theme.SurfaceBg}"
                    BorderBrush="{DynamicResource Theme.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14"
                    Margin="0,0,0,20">
                <TextBlock Text="Este login ficará salvo na máquina, com isso, todo acesso que esse equipamento fizer, ficará um log no sistema que você realizou esse acesso."
                           FontSize="13.5"
                           LineHeight="21"
                           Foreground="{DynamicResource Theme.TextHeading}"
                           FontWeight="Medium"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Botões de Ação -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Height="40"
                        Background="{DynamicResource Theme.CardBg}"
                        Foreground="{DynamicResource Theme.TextBody}"
                        BorderBrush="{DynamicResource Theme.BorderStrong}"
                        BorderThickness="1"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2"
                        Content="Salvar Login"
                        Height="40"
                        Background="#4F46E5"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnConfirm_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>

