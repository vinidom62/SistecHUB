<Window x:Class="SistecHub.Modulos.AcessoRemoto.AcessoRemotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SistecHub - Acesso remoto" Height="820" Width="1280"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource Theme.PageBg}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <!-- Paleta (BgDeep, BgPanel, BgControl, Line, LineStrong, TextMain e TextMuted vêm de AppThemeManager) -->
        <SolidColorBrush x:Key="BgBar" Color="#0C1220"/>
        <SolidColorBrush x:Key="Accent" Color="#6366F1"/>

        <!-- ScrollBar -->
        <Style x:Key="ScrollRepeatTransparent" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#475569" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollRepeatTransparent}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollRepeatTransparent}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollRepeatTransparent}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollRepeatTransparent}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botões -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <Border x:Name="Hover" Background="#6366F1" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Theme.CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.IndigoText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.IndigoSoftBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSubtle}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
        <Style x:Key="MenuItemButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="14,9"/>
        </Style>

        <!-- Caixas de texto -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="#6366F1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="#6366F1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.StrongBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.IndigoHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Theme.CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
                            <ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.6"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                            <ToggleButton Opacity="0" ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320" Margin="0,4,0,8" Padding="4"
                                        Background="{DynamicResource Theme.CardBg}" BorderBrush="{DynamicResource Theme.BorderStrong}" BorderThickness="1" CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lista de arquivos -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{DynamicResource Theme.CardBg}" BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="0,0,0,1" Padding="8,10">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="0,7" Margin="4,1">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.StrongBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.IndigoHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.IndigoText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de progresso -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Theme.StrongBg}"/>
            <Setter Property="Foreground" Value="#6366F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ContextMenu Moderno -->
        <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="12">
                            <Border Background="{DynamicResource Theme.CardBg}"
                                    BorderBrush="{DynamicResource Theme.BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="6"
                                    MinWidth="230">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.14" Color="#0F172A"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator do Menu -->
        <Style x:Key="ModernMenuSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Theme.StrongBg}"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource Theme.StrongBg}" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MenuItem Moderno com Ícones -->
        <Style x:Key="ModernMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Icon}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SubtleBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.IndigoText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MenuItem de Perigo (Excluir) -->
        <Style x:Key="ModernDangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.DangerText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Icon}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.DangerSoftBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.DangerText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho Executivo Unificado -->
        <Border x:Name="HeaderBar" Grid.Row="0" Height="64" Background="{StaticResource BgBar}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,0">
            <Border.Resources>
                <SolidColorBrush x:Key="BgControl" Color="#1E293B"/>
                <SolidColorBrush x:Key="Line" Color="#334155"/>
                <SolidColorBrush x:Key="LineStrong" Color="#475569"/>
                <SolidColorBrush x:Key="TextMain" Color="#F1F5F9"/>
                <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </Style>
                <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Width" Value="36"/>
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / Marca -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="ImgLogo" Height="34" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtBrandFallback" Text="SISTEC" FontSize="18" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status da Conexão -->
                <Border x:Name="StatusBadge" Grid.Column="1" Margin="16,0,0,0" Background="{StaticResource BgControl}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#EF4444" Margin="0,0,8,0"/>
                        <TextBlock x:Name="LblStatusText" Text="Desconectado" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Seletor de Abas (Centralizado) -->
                <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource BgControl}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="11" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="NavBtnScreen" Content="Tela remota" Click="NavBtnScreen_Click" Style="{StaticResource TabButton}"
                                Background="#6366F1" Foreground="White"/>
                        <Button x:Name="NavBtnFiles" Content="Arquivos" Click="NavBtnFiles_Click" Style="{StaticResource TabButton}" Margin="2,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ações e Ferramentas (Ícones Vetoriais SVG) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Ações da Sessão de Tela Remota (escondidas ao ver arquivos) -->
                    <StackPanel x:Name="ToolbarBar" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Seletores de Monitores -->
                        <StackPanel x:Name="PnlMonitors" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0"/>

                        <!-- Bloquear Entrada Remota (Cadeado Vetorial) -->
                        <Button x:Name="BtnBlockInput" Click="BtnBlockInput_Click" IsEnabled="False"
                                Style="{StaticResource HeaderIconButton}" ToolTip="Bloquear teclado e mouse remotos">
                            <Path x:Name="PathBlockInput"
                                  Data="M 7,11 V 7 A 5,5 0 0 1 17,7 V 11 M 5,11 H 19 A 2,2 0 0 1 21,13 V 20 A 2,2 0 0 1 19,22 H 5 A 2,2 0 0 1 3,20 V 13 A 2,2 0 0 1 5,11 Z"
                                  Stroke="#E2E8F0" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Ações Rápidas (Raio Vetorial) -->
                        <Button x:Name="MenuQuickActions" Click="MenuQuickActions_Click" IsEnabled="False"
                                Style="{StaticResource HeaderIconButton}" ToolTip="Ações rápidas (Ctrl+Alt+Del, Bloquear, Reiniciar...)">
                            <Path Data="M 13,2 L 3,14 H 12 L 11,22 L 21,10 H 12 Z"
                                  Stroke="#E2E8F0" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="14" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Popup x:Name="PopupActions" PlacementTarget="{Binding ElementName=MenuQuickActions}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Margin="0,6,12,12" Padding="6" MinWidth="260" Background="{DynamicResource Theme.CardBg}"
                                    BorderBrush="{DynamicResource Theme.BorderStrong}" BorderThickness="1" CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="Black"/>
                                </Border.Effect>
                                <StackPanel ButtonBase.Click="PopupActions_Click">
                                    <Button Click="MenuAction_CAD_Click" Style="{StaticResource MenuItemButton}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 3,6 H 21 A 2,2 0 0 1 23,8 V 16 A 2,2 0 0 1 21,18 H 3 A 2,2 0 0 1 1,16 V 8 A 2,2 0 0 1 3,6 Z M 6,10 H 6.01 M 10,10 H 10.01 M 14,10 H 14.01 M 18,10 H 18.01 M 7,14 H 17"
                                                  Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Enviar Ctrl + Alt + Del" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MenuAction_Lock_Click" Style="{StaticResource MenuItemButton}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 7,11 V 7 A 5,5 0 0 1 17,7 V 11 M 5,11 H 19 A 2,2 0 0 1 21,13 V 20 A 2,2 0 0 1 19,22 H 5 A 2,2 0 0 1 3,20 V 13 A 2,2 0 0 1 5,11 Z"
                                                  Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Bloquear estação (Win + L)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MenuAction_Taskmgr_Click" Style="{StaticResource MenuItemButton}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 22,12 H 18 L 15,21 L 9,3 L 6,12 H 2"
                                                  Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Gerenciador de tarefas" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MenuAction_Desktop_Click" Style="{StaticResource MenuItemButton}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 3,3 H 21 A 2,2 0 0 1 23,5 V 15 A 2,2 0 0 1 21,17 H 3 A 2,2 0 0 1 1,15 V 5 A 2,2 0 0 1 3,3 Z M 8,21 H 16 M 12,17 V 21"
                                                  Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Mostrar área de trabalho (Win + D)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MenuAction_Cmd_Click" Style="{StaticResource MenuItemButton}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 4,17 L 10,11 L 4,5 M 12,19 H 20"
                                                  Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Prompt de comando (CMD)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Height="1" Background="{DynamicResource Theme.StrongBg}" Margin="4,4"/>
                                    <Button Click="MenuAction_Reboot_Click" Style="{StaticResource MenuItemButton}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 21,12 A 9,9 0 1 1 18.36,5.64 L 21,3 V 9 H 15"
                                                  Stroke="#DC2626" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Reiniciar computador remoto" Foreground="{DynamicResource Theme.DangerText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Alternar Exibição do Cursor do Cliente (Mouse / Cursor Vetorial) -->
                        <Button x:Name="BtnToggleRemoteCursor" Click="BtnToggleRemoteCursor_Click"
                                Style="{StaticResource HeaderIconButton}" ToolTip="Cursor do cliente visível (Clique para ocultar)">
                            <Path x:Name="PathToggleRemoteCursor"
                                  Data="M 3,3 L 10,21 L 12.5,13.5 L 20,11 Z"
                                  Fill="#6366F1" Stroke="#A5B4FC" StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  Width="13" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Alternar Tela Cheia (Vetor Expansão) -->
                        <Button x:Name="BtnFullscreen" Click="BtnFullscreen_Click"
                                Style="{StaticResource HeaderIconButton}" ToolTip="Alternar tela cheia">
                            <Path x:Name="PathFullscreen"
                                  Data="M 15,3 H 21 V 9 M 9,21 H 3 V 15 M 21,3 L 14,10 M 3,21 L 10,14"
                                  Stroke="#E2E8F0" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Divisória Sutil -->
                    <Border Width="1" Height="22" Background="{StaticResource Line}" Margin="4,0,10,0"/>

                    <!-- Chat (Ícone Vetorial de Balão de Mensagem) -->
                    <Button x:Name="BtnChat" Click="BtnChat_Click"
                            Style="{StaticResource HeaderIconButton}" ToolTip="Chat da sessão">
                        <Grid>
                            <Path x:Name="PathChat"
                                  Data="M 21,15 A 2,2 0 0 1 19,17 H 7 L 3,21 V 5 A 2,2 0 0 1 5,3 H 19 A 2,2 0 0 1 21,5 Z"
                                  Stroke="#E2E8F0" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="BadgeChat" Visibility="Collapsed" Background="#EF4444" CornerRadius="8"
                                    MinWidth="16" Height="16" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,-8,-8,0">
                                <TextBlock x:Name="LblChatBadge" Text="0" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Desconectar (Ícone Vetorial Power) -->
                    <Button x:Name="BtnDisconnect" Click="BtnDisconnect_Click" IsEnabled="False"
                            Style="{StaticResource DangerButton}" Height="36" Padding="14,0" Margin="2,0,0,0" ToolTip="Encerrar sessão de suporte">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 18.36,6.64 A 9,9 0 1 1 5.64,6.64 M 12,2 V 12"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Desconectar" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Elemento Oculto (compatibilidade com code-behind) -->
                    <TextBlock x:Name="LblFpsInfo" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo das abas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
            <!-- ABA 1: TELA REMOTA -->
            <Grid x:Name="ViewScreen" Visibility="Visible" AllowDrop="True"
                  Background="{DynamicResource Theme.PageGradient}"
                  ForceCursor="True" QueryCursor="ViewScreen_QueryCursor"
                  DragOver="ViewScreen_DragOver" DragLeave="ViewScreen_DragLeave" Drop="ViewScreen_Drop">

                <Border x:Name="DisconnectedCard" Width="460" Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="18" Visibility="Visible">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="48" ShadowDepth="10" Opacity="0.12" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="44" Height="4" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Margin="0,0,0,18"/>
                        <TextBlock Text="Conectar a um computador" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="Informe o ID e a senha informados pelo cliente para iniciar a assistência remota."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,26"/>

                        <TextBlock Text="ID DO COMPUTADOR REMOTO" Style="{StaticResource FieldLabel}" Foreground="#818CF8"/>
                        <TextBox x:Name="TxtTargetId" Height="44" FontSize="17" FontWeight="Bold" Margin="0,0,0,18"/>

                        <TextBlock Text="SENHA DE ACESSO (PIN)" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="TxtPassword" Height="42" FontSize="14" Margin="0,0,0,18"/>

                        <TextBlock Text="SERVIDOR RELAY" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtServerUrl" Height="36" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,28"/>

                        <Button x:Name="BtnConnect" Content="Iniciar conexão" Click="BtnConnect_Click"
                                Style="{StaticResource PrimaryButton}" Height="46" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border x:Name="WaitingCard" Width="440" Padding="36,30" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="18" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="48" ShadowDepth="10" Opacity="0.12" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="WaitPulseScale"/></Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.5"/>
                                                <DoubleAnimation Storyboard.TargetName="WaitPulseScale" Storyboard.TargetProperty="ScaleX" From="0.8" To="1.4" Duration="0:0:1.5"/>
                                                <DoubleAnimation Storyboard.TargetName="WaitPulseScale" Storyboard.TargetProperty="ScaleY" From="0.8" To="1.4" Duration="0:0:1.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="52" Height="52" Fill="{StaticResource Accent}"/>
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Aguardando aceitação do usuário" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.TextPrimary}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="O cliente recebeu a solicitação de acesso e precisa permitir a conexão para que a tela seja exibida."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"/>

                        <!-- Seção condicional 1: Acesso com Senha (Liberado para Técnico Autenticado no GLPI) -->
                        <StackPanel x:Name="WaitingPasswordSection">
                            <!-- Divisor: OU CONECTAR COM SENHA -->
                            <Grid Margin="0,22,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="1" Background="{DynamicResource Line}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="OU CONECTAR COM SENHA" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.TextSubtle}" Margin="12,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Height="1" Background="{DynamicResource Line}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Entrada manual de senha -->
                            <TextBlock Text="SENHA DE ACESSO" Style="{StaticResource FieldLabel}"/>
                            <Border Height="42"
                                    Background="{DynamicResource Theme.SurfaceBg}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="#6366F1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="12,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="&#xE8D7;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="{DynamicResource Theme.TextSubtle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               IsHitTestVisible="False"/>

                                    <Grid Grid.Column="1">
                                        <PasswordBox x:Name="PwdWaitingPassword"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     FontSize="14"
                                                     FontWeight="SemiBold"
                                                     MaxLength="32"
                                                     VerticalContentAlignment="Center"
                                                     PasswordChanged="PwdWaitingPassword_PasswordChanged"
                                                     KeyDown="WaitingPassword_KeyDown"/>

                                        <TextBox x:Name="TxtWaitingPasswordRevealed"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 MaxLength="32"
                                                 VerticalContentAlignment="Center"
                                                 Visibility="Collapsed"
                                                 TextChanged="TxtWaitingPasswordRevealed_TextChanged"
                                                 KeyDown="WaitingPassword_KeyDown"/>

                                        <TextBlock x:Name="HintWaitingPassword"
                                                   Text="Digite a senha para pular a espera"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource Theme.TextSubtle}"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>

                                    <Button Grid.Column="2"
                                            x:Name="BtnToggleWaitingPasswordEye"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            ToolTip="Mostrar/Ocultar senha"
                                            Click="BtnToggleWaitingPasswordEye_Click">
                                        <TextBlock x:Name="IconWaitingPasswordEye"
                                                   Text="&#xE7B3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource Theme.TextMuted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="LblWaitingPasswordError"
                                       Text=""
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.DangerText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="Collapsed"/>

                            <Button x:Name="BtnSubmitWaitingPassword"
                                    Content="Entrar com senha"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="42"
                                    FontSize="13.5"
                                    FontWeight="Bold"
                                    Margin="0,14,0,0"
                                    Click="BtnSubmitWaitingPassword_Click"/>
                        </StackPanel>

                        <!-- Seção condicional 2: Aviso Supervisionado Apenas (Sem Login GLPI) -->
                        <Border x:Name="WaitingSupervisedNotice"
                                Background="{DynamicResource Theme.SurfaceBg}"
                                BorderBrush="{DynamicResource Theme.BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,16"
                                Margin="0,20,0,0"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Acesso com senha restrito" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Apenas acesso supervisionado disponível no momento. Para liberar o acesso direto por senha, faça login na sua conta."
                                           FontSize="11.5" Foreground="{DynamicResource Theme.TextMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button x:Name="BtnWaitingGlpiLogin"
                                        Content="Fazer Login"
                                        Style="{StaticResource OutlineButton}"
                                        Height="34"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Padding="18,0"
                                        HorizontalAlignment="Center"
                                        Click="BtnWaitingGlpiLogin_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Image x:Name="ImgRemoteScreen" Stretch="Uniform" Focusable="True"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       ForceCursor="True" QueryCursor="ImgRemoteScreen_QueryCursor"
                       SizeChanged="ImgRemoteScreen_SizeChanged"
                       MouseMove="ImgRemoteScreen_MouseMove"
                       MouseDown="ImgRemoteScreen_MouseDown"
                       MouseUp="ImgRemoteScreen_MouseUp"
                       MouseWheel="ImgRemoteScreen_MouseWheel"/>

                <!-- Overlay do Cursor do Cliente -->
                <Canvas x:Name="CanvasCursorOverlay" IsHitTestVisible="False" ClipToBounds="True">
                    <Grid x:Name="ClientCursorContainer" Visibility="Collapsed" IsHitTestVisible="False">
                        <!-- Glow / Halo suave sob o cursor -->
                        <Ellipse Width="24" Height="24" Margin="-8,-8,0,0" Fill="#3B82F6" Opacity="0.25">
                            <Ellipse.Effect>
                                <BlurEffect Radius="8"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Seta / Ponteiro Vetorial do Cliente (Ponta exata em 0,0) -->
                        <Path x:Name="PathClientCursor"
                              Data="M 0,0 L 0,18 L 4.5,13.5 L 8.5,21.5 L 11,20 L 7,12 L 12.5,12 Z"
                              Fill="#FFFFFF" Stroke="{DynamicResource Theme.TextHeading}" StrokeThickness="1.5"
                              StrokeLineJoin="Round">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="315" Opacity="0.5"/>
                            </Path.Effect>
                        </Path>

                        <!-- Badge / Tag "Cliente" / "Cliente Ativo" -->
                        <Border x:Name="BadgeClientCursor"
                                Margin="14,14,0,0" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1"
                                CornerRadius="4" Padding="5,1,5,2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock x:Name="TxtClientBadge" Text="Cliente" FontSize="9.5" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </Grid>
                </Canvas>

                <!-- Overlay / Pílula Informativa de Prioridade do Cliente -->
                <Border x:Name="PillClientPriority" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                        Background="#DC2626" CornerRadius="18" Padding="16,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 4.93,6.34 L 17.66,19.07 C 16.14,20.27 14.16,21 12,21 C 7.03,21 3,16.97 3,12 C 3,9.84 3.73,7.86 4.93,6.34 Z M 19.07,17.66 L 6.34,4.93 C 7.86,3.73 9.84,3 12,3 C 16.97,3 21,7.03 21,12 C 21,14.16 20.27,16.14 19.07,17.66 Z"
                              Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="O cliente está usando o mouse/teclado — suas entradas estão pausadas"
                                   FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Overlay Visual de Drag & Drop -->
                <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="#CC0F172A" BorderBrush="#6366F1" BorderThickness="3" CornerRadius="16" Margin="24">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#6366F1" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="M 12,17 V 5 M 7,10 L 12,5 L 17,10 M 4,19 H 20"
                                  Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Solte os arquivos aqui para enviar à Área de Trabalho remota"
                                   FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Os arquivos serão enviados diretamente para o Desktop do computador remoto"
                                   FontSize="13" Foreground="#CBD5E1" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card Flutuante de Progresso de Transferência (Drag & Drop na Tela Remota) -->
                <Border x:Name="ScreenTransferToast" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Width="370"
                        Background="#F20F172A" BorderBrush="#4F46E5" BorderThickness="1.5" CornerRadius="14" Padding="16,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.38" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ToastIconBadge" Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#6366F1" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path x:Name="ToastIconPath"
                                      Data="M 12,17 V 5 M 7,10 L 12,5 L 17,10 M 4,19 H 20"
                                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LblToastTitle" Text="Enviando para a Área de Trabalho..."
                                           FontSize="12.5" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LblToastFileName" Text=""
                                           FontSize="11.5" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>

                            <Border x:Name="BadgeToastCounter" Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                    CornerRadius="6" Padding="7,2" VerticalAlignment="Top" Margin="8,0,0,0">
                                <TextBlock x:Name="LblToastCounter" Text="1 de 1" FontSize="10.5" FontWeight="SemiBold" Foreground="#A5B4FC"/>
                            </Border>
                        </Grid>

                        <ProgressBar x:Name="ToastProgressBar" Height="7" Minimum="0" Maximum="100" Value="0"
                                     Background="#1E293B" Foreground="#6366F1" Margin="0,2,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblToastBytes" Grid.Column="0" Text="0 KB de 0 KB"
                                       FontSize="11" Foreground="{DynamicResource Theme.TextSubtle}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblToastPercent" Grid.Column="1" Text="0%"
                                       FontSize="11.5" FontWeight="Bold" Foreground="#818CF8" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ABA 2: GERENCIADOR DE ARQUIVOS (Layout Moderno e Intuitivo) -->
            <Grid x:Name="ViewFiles" Visibility="Collapsed" Background="{DynamicResource Theme.SubtleBg}" AllowDrop="True"
                  DragOver="ViewFiles_DragOver" DragLeave="ViewFiles_DragLeave" Drop="ViewFiles_Drop">
                <Border Margin="16" Background="{DynamicResource Theme.CardBg}" BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Barra de Ações Principais -->
                            <RowDefinition Height="Auto"/>
                            <!-- Barra de Navegação e Caminho -->
                            <RowDefinition Height="Auto"/>
                            <!-- Tabela de Arquivos -->
                            <RowDefinition Height="*"/>
                            <!-- Rodapé de Status e Progresso -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Barra de Ações Principais (Topo) -->
                        <Border Grid.Row="0" Background="{DynamicResource Theme.SurfaceBg}" BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="0,0,0,1" Padding="16,12" CornerRadius="12,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Título com Ícone -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Theme.IndigoSoftBg}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                                        <Path Data="M 3,7 A 2,2 0 0 1 5,5 H 10 L 12,7 H 19 A 2,2 0 0 1 21,9 V 17 A 2,2 0 0 1 19,19 H 5 A 2,2 0 0 1 3,17 Z"
                                              Stroke="#6366F1" Fill="#E0E7FF" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Gerenciador de Arquivos Remoto" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                                        <TextBlock Text="Navegue pelas pastas e transfira arquivos entre os computadores" FontSize="11.5" Foreground="{DynamicResource Theme.TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Botões de Ação Principais -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Baixar Arquivo -->
                                    <Button Click="BtnDownloadFile_Click" Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0" Margin="0,0,8,0"
                                            ToolTip="Baixar o arquivo selecionado para este computador">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 12,3 V 15 M 7,10 L 12,15 L 17,10 M 4,19 H 20"
                                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Baixar arquivo" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Enviar Arquivo -->
                                    <Button Click="BtnUploadFile_Click" Height="36" Padding="14,0" Margin="0,0,8,0"
                                            ToolTip="Enviar um arquivo deste computador para a pasta remota atual">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 12,17 V 5 M 7,10 L 12,5 L 17,10 M 4,19 H 20"
                                                  Stroke="{DynamicResource Theme.TextPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Enviar arquivo" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Nova Pasta -->
                                    <Button Click="BtnNewFolder_Click" Height="36" Padding="14,0" Margin="0,0,8,0"
                                            ToolTip="Criar uma nova pasta no diretório remoto">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 3,7 A 2,2 0 0 1 5,5 H 10 L 12,7 H 19 A 2,2 0 0 1 21,9 V 17 A 2,2 0 0 1 19,19 H 5 A 2,2 0 0 1 3,17 Z M 12,11 V 17 M 9,14 H 15"
                                                  Stroke="{DynamicResource Theme.TextPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Nova pasta" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Excluir -->
                                    <Button Click="BtnDeleteFile_Click" Style="{StaticResource DangerButton}" Height="36" Padding="14,0"
                                            ToolTip="Excluir o arquivo ou pasta selecionada no cliente">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 3,6 H 21 M 8,6 V 4 A 2,2 0 0 1 10,2 H 14 A 2,2 0 0 1 16,4 V 6 M 19,6 V 20 A 2,2 0 0 1 17,22 H 7 A 2,2 0 0 1 5,20 V 6 M 10,11 V 17 M 14,11 V 17"
                                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Excluir" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Barra de Endereço, Navegação e Unidades -->
                        <Border Grid.Row="1" Background="{DynamicResource Theme.CardBg}" BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="0,0,0,1" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Botões Subir e Atualizar -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Seletor de Unidades (C:, D:, etc.) -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Barra de Caminho com Ícone -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Botões de Navegação -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Button Click="BtnUpDir_Click" Height="36" Width="38" Padding="0" Margin="0,0,6,0"
                                            ToolTip="Subir pasta / Nível acima (Backspace)">
                                        <Path Data="M 12,19 V 5 M 5,12 L 12,5 L 19,12"
                                              Stroke="{DynamicResource Theme.TextBody}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <Button Click="BtnRefreshFiles_Click" Height="36" Width="38" Padding="0"
                                            ToolTip="Atualizar lista de arquivos (F5)">
                                        <Path Data="M 21,12 A 9,9 0 1 1 18.36,5.64 L 21,3 V 9 H 15"
                                              Stroke="{DynamicResource Theme.TextBody}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                                <!-- Unidades de Disco -->
                                <StackPanel x:Name="PnlDrives" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <!-- Caixa de Caminho -->
                                <Grid Grid.Column="2">
                                    <TextBox x:Name="TxtCurrentPath" Height="36" Text="C:\" KeyDown="TxtCurrentPath_KeyDown"
                                             Padding="34,0,10,0" VerticalContentAlignment="Center" FontSize="12.5"
                                             FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource Theme.TextPrimary}" Background="{DynamicResource Theme.SurfaceBg}"/>
                                    <Path Data="M 3,7 A 2,2 0 0 1 5,5 H 10 L 12,7 H 19 A 2,2 0 0 1 21,9 V 17 A 2,2 0 0 1 19,19 H 5 A 2,2 0 0 1 3,17 Z"
                                          Stroke="{DynamicResource Theme.TextSubtle}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Lista de Arquivos (com Ícones Vetoriais Diferenciados) -->
                        <Border Grid.Row="2" Background="{DynamicResource Theme.CardBg}">
                            <ListView x:Name="LvFiles" Background="Transparent" Foreground="{DynamicResource Theme.TextPrimary}" BorderThickness="0"
                                      MouseDoubleClick="LvFiles_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="LvFiles_PreviewMouseRightButtonDown"
                                      ContextMenuOpening="LvFiles_ContextMenuOpening"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                        <!-- Abrir pasta selecionada -->
                                        <MenuItem x:Name="MenuOpenFolder"
                                                  Header="Abrir pasta"
                                                  Click="MenuOpenFolder_Click"
                                                  Style="{StaticResource ModernMenuItem}">
                                            <MenuItem.Icon>
                                                <Path Data="M 3,7 A 2,2 0 0 1 5,5 H 10 L 12,7 H 19 A 2,2 0 0 1 21,9 V 17 A 2,2 0 0 1 19,19 H 5 A 2,2 0 0 1 3,17 Z"
                                                      Stroke="#D97706" Fill="#FEF3C7" StrokeThickness="1.5"
                                                      Width="15" Height="15" Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <!-- Baixar item selecionado -->
                                        <MenuItem x:Name="MenuDownloadItem"
                                                  Header="Baixar arquivo selecionado"
                                                  Click="BtnDownloadFile_Click"
                                                  Style="{StaticResource ModernMenuItem}">
                                            <MenuItem.Icon>
                                                <Path Data="M 12,3 V 15 M 12,15 L 7,10 M 12,15 L 17,10 M 4,19 H 20"
                                                      Stroke="#6366F1" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="14" Height="14" Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <!-- Enviar arquivo local -->
                                        <MenuItem Header="Enviar arquivo para cá..."
                                                  Click="BtnUploadFile_Click"
                                                  Style="{StaticResource ModernMenuItem}">
                                            <MenuItem.Icon>
                                                <Path Data="M 12,17 V 5 M 12,5 L 7,10 M 12,5 L 17,10 M 4,19 H 20"
                                                      Stroke="#059669" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="14" Height="14" Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <!-- Criar nova pasta -->
                                        <MenuItem Header="Criar nova pasta aqui..."
                                                  Click="BtnNewFolder_Click"
                                                  Style="{StaticResource ModernMenuItem}">
                                            <MenuItem.Icon>
                                                <Path Data="M 3,7 A 2,2 0 0 1 5,5 H 10 L 12,7 H 19 A 2,2 0 0 1 21,9 V 17 A 2,2 0 0 1 19,19 H 5 A 2,2 0 0 1 3,17 Z M 12,11 V 15 M 10,13 H 14"
                                                      Stroke="#0284C7" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="15" Height="15" Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <Separator Style="{StaticResource ModernMenuSeparator}"/>

                                        <!-- Excluir item -->
                                        <MenuItem x:Name="MenuDeleteItem"
                                                  Header="Excluir item selecionado"
                                                  Click="BtnDeleteFile_Click"
                                                  Style="{StaticResource ModernDangerMenuItem}">
                                            <MenuItem.Icon>
                                                <Path Data="M 3,6 H 21 M 8,6 V 4 A 1,1 0 0 1 9,3 H 15 A 1,1 0 0 1 16,4 V 6 M 19,6 V 19 A 2,2 0 0 1 17,21 H 7 A 2,2 0 0 1 5,19 V 6 M 10,11 V 16 M 14,11 V 16"
                                                      Stroke="#DC2626" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="14" Height="14" Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <Separator Style="{StaticResource ModernMenuSeparator}"/>

                                        <!-- Atualizar -->
                                        <MenuItem Header="Atualizar pasta"
                                                  Click="BtnRefreshFiles_Click"
                                                  Style="{StaticResource ModernMenuItem}">
                                            <MenuItem.Icon>
                                                <Path Data="M 21,12 A 9,9 0 1 1 18.36,5.64 L 21,3 V 9 H 15"
                                                      Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="14" Height="14" Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Nome" Width="550">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                                        <Path Data="{Binding IconData}" Stroke="{Binding IconStroke}" Fill="{Binding IconFill}"
                                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="{Binding NameFontWeight}" FontSize="12.5"
                                                                   Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Tipo" Width="140" DisplayMemberBinding="{Binding TypeStr}"/>
                                        <GridViewColumn Header="Tamanho" Width="120" DisplayMemberBinding="{Binding SizeStr}"/>
                                        <GridViewColumn Header="Modificado em" Width="200" DisplayMemberBinding="{Binding ModTime}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <!-- Rodapé de Status e Progresso -->
                        <Border Grid.Row="3" Background="{DynamicResource Theme.SurfaceBg}" BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,10" CornerRadius="0,0,12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <!-- Contador de Itens -->
                                <TextBlock x:Name="LblItemsCount" Grid.Column="0" Text="0 itens" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMuted}" VerticalAlignment="Center"/>

                                <!-- Status da Transferência -->
                                <TextBlock x:Name="LblTransferStatus" Grid.Column="2" Text="Pronto para transferências."
                                           Foreground="{DynamicResource Theme.TextMuted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- Barra de Progresso -->
                                <ProgressBar x:Name="TransferProgressBar" Grid.Column="3" Height="8" VerticalAlignment="Center" Maximum="100" Value="0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Overlay Visual de Drag & Drop no Gerenciador de Arquivos -->
                <Border x:Name="DropFilesOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="#CC0F172A" BorderBrush="#6366F1" BorderThickness="3" CornerRadius="16" Margin="24">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#6366F1" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="M 12,17 V 5 M 7,10 L 12,5 L 17,10 M 4,19 H 20"
                                  Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Solte os arquivos ou pastas aqui para enviar à pasta remota atual"
                                   FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="As pastas e arquivos chegarão extraídos normalmente no diretório remoto aberto"
                                   FontSize="13" Foreground="#CBD5E1" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            </Grid>

            <!-- PAINEL DE CHAT (lateral direito) -->
            <Border x:Name="ViewChat" Grid.Column="1" Width="380" Visibility="Collapsed"
                    Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18,0,10,0" Height="56" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Chat com o cliente" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Exportar" Click="BtnExportChat_Click" Height="30" Padding="12,0" FontSize="11.5" Margin="0,0,6,0"/>
                                <Button Click="BtnCloseChat_Click"
                                        Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Fechar chat">
                                    <Path Data="M 18,6 L 6,18 M 6,6 L 18,18" Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="LstChat" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BgColor}" CornerRadius="10" Padding="12,9" Margin="2,4">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{Binding Sender}" Foreground="{Binding SenderColor}" FontWeight="Bold" FontSize="11.5" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Theme.TextMuted}" FontSize="10.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Theme.TextPrimary}" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Padding="14" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtChatMessage" Grid.Column="0" Height="40" KeyDown="TxtChatMessage_KeyDown"/>
                            <Button Content="Enviar" Grid.Column="1" Click="BtnSendChat_Click" Style="{StaticResource PrimaryButton}"
                                    Width="84" Height="40" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    
        <!-- Modal Overlay Moderno: Criar Nova Pasta -->
        <Grid x:Name="ModalNewFolderOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="1000">
            <!-- Fundo Escuro Translúcido -->
            <Border Background="#990F172A" MouseDown="ModalNewFolder_Backdrop_MouseDown"/>

            <!-- Caixa de Diálogo Moderna -->
            <Border Width="430" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Theme.CardBg}" BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.25" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Cabeçalho do Modal com Ícone -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Background="{DynamicResource Theme.WarningSoftBg}" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                            <Path Data="M 3,7 A 2,2 0 0 1 5,5 H 10 L 12,7 H 19 A 2,2 0 0 1 21,9 V 17 A 2,2 0 0 1 19,19 H 5 A 2,2 0 0 1 3,17 Z M 12,11 V 17 M 9,14 H 15"
                                  Stroke="#D97706" Fill="#FEF3C7" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Criar Nova Pasta Remota" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                            <TextBlock x:Name="LblNewFolderLocation" Text="Local: C:\" FontSize="11.5" Foreground="{DynamicResource Theme.TextMuted}" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Campo de Texto -->
                    <TextBlock Text="NOME DA PASTA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtNewFolderName" Height="40" Text="Nova Pasta"
                             FontSize="13" Padding="12,0" VerticalContentAlignment="Center"
                             KeyDown="TxtNewFolderName_KeyDown" Margin="0,0,0,22"/>

                    <!-- Botões de Ação -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="Cancelar" Click="BtnCancelNewFolder_Click"
                                Height="38" Padding="16,0" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="Criar Pasta" Click="BtnConfirmNewFolder_Click"
                                Style="{StaticResource PrimaryButton}" Height="38" Padding="20,0" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
