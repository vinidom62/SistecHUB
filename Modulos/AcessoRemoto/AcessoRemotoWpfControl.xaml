<UserControl x:Class="SistecHub.Modulos.AcessoRemoto.AcessoRemotoWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Card branco padrão com borda suave e sombra sutil -->
        <Style x:Key="ElevatedCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Primário Indigo (44px) -->
        <Style x:Key="PrimaryIndigoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Secundário Contorno -->
        <Style x:Key="OutlineRoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Integrado de Reconectar / Atualizar no Cabeçalho -->
        <Style x:Key="HeaderRefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C7D2FE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Pastel Indigo (Abrir Chat) -->
        <Style x:Key="SoftIndigoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C7D2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Vermelho Sólido (Encerrar Sessão) -->
        <Style x:Key="DangerSolidButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Pastel Vermelho -->
        <Style x:Key="SoftDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Cabeçalho Superior -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Título e Subtítulo -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Acesso remoto"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <Border Background="#EEF2FF"
                            CornerRadius="6"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="SUPORTE SISTEC"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="#4F46E5"/>
                    </Border>
                </StackPanel>

                <Border Width="48"
                        Height="4"
                        CornerRadius="2"
                        Background="#6366F1"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"/>

                <TextBlock Text="Compartilhe seu código para receber assistência técnica ou conecte-se a outro computador remoto."
                           FontSize="13"
                           Foreground="#64748B"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Painel Integrado: Status da Conexão + Perfil Técnico GLPI + Botão Reconectar -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="16,4,0,0">

                <!-- Botão de Login do Técnico (Visível quando DESCONECTADO) -->
                <Button x:Name="BtnHeaderGlpiLogin"
                        Style="{StaticResource HeaderRefreshButtonStyle}"
                        Height="44"
                        Padding="12,0"
                        Margin="0,0,10,0"
                        ToolTip="Fazer login para desbloquear o acesso remoto por senha"
                        Click="BtnHeaderGlpiLogin_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22"
                                CornerRadius="11"
                                Background="#EEF2FF"
                                Margin="0,0,8,0">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="#4F46E5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Login"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#4F46E5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Card de Perfil do Técnico GLPI (Visível quando AUTENTICADO no GLPI) -->
                <Border x:Name="HeaderTechnicianCard"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="44"
                        Padding="10,0,8,0"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Avatar (Imagem ou Fallback com Iniciais) -->
                        <Grid Width="28" Height="28" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Ellipse x:Name="HeaderAvatarFallback" Fill="#4F46E5"/>
                            <TextBlock x:Name="HeaderAvatarInitials"
                                       Text="TS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Ellipse x:Name="HeaderAvatarImageCircle" Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="HeaderAvatarImageBrush" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <!-- Nome do Técnico e Badge Ativo -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtHeaderTechName"
                                       Text="Técnico"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       MaxWidth="140"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="● Técnico Angelus"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#16A34A"/>
                        </StackPanel>

                        <!-- Divisor vertical -->
                        <Border Width="1" Height="20" Background="#E2E8F0" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Botão Sair / Desconectar -->
                        <Button x:Name="BtnHeaderGlpiLogout"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="26" Height="26"
                                Cursor="Hand"
                                ToolTip="Desconectar conta Angelus"
                                Click="BtnHeaderGlpiLogout_Click">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card Integrado: Status da Conexão + Botão Reconectar/Atualizar -->
                <Border x:Name="HeaderStatusCard"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="44"
                        Padding="12,0,6,0"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Ponto Luminoso de Status -->
                        <Border x:Name="StatusDotContainer"
                                Width="8" Height="8"
                                CornerRadius="4"
                                Background="#10B981"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"/>

                        <!-- Textos de Status -->
                        <StackPanel VerticalAlignment="Center" MinWidth="110">
                            <TextBlock x:Name="TxtStatusCategory"
                                       Text="STATUS DO SERVIDOR"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#64748B"
                                       Margin="0,0,0,1"/>
                            <TextBlock x:Name="TxtStatusBadge"
                                       Text="Conectando…"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"/>
                        </StackPanel>

                        <!-- Divisor vertical discreto -->
                        <Border Width="1"
                                Height="22"
                                Background="#E2E8F0"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center"/>

                        <!-- Botão Reconectar com animação de giro contínuo -->
                        <Button x:Name="BtnReconnect"
                                Style="{StaticResource HeaderRefreshButtonStyle}"
                                Height="32"
                                Padding="10,0"
                                ToolTip="Reconectar ao servidor de acesso remoto"
                                Click="BtnReconnect_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="IconReconnect"
                                           Text="&#xE72C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="#334155"
                                           RenderTransformOrigin="0.5,0.5"
                                           VerticalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ReconnectRotateTransform" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="TxtRefreshBtnLabel"
                                           Text="Reconectar"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Row 1: Conteúdo Rolável -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Sessão Ativa (se houver) -->
                    <RowDefinition Height="Auto"/> <!-- Cards Principais (Host e Viewer) -->
                </Grid.RowDefinitions>

                <!-- CARD DE SESSÃO REMOTA ATIVA (Banner Destaque) -->
                <Border x:Name="ActiveSessionCard"
                        Grid.Row="0"
                        Background="#F0FDF4"
                        BorderBrush="#86EFAC"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="26,18"
                        Margin="0,0,0,22"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#166534" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.06"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Esquerda: Avatar + Identificação do Técnico Conectado -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Grid Width="50" Height="50" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Ellipse x:Name="AvatarFallbackCircle"
                                         Fill="#10B981"/>
                                <TextBlock x:Name="TxtAvatarInitials"
                                           Text="TS"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Ellipse x:Name="AvatarImageCircle"
                                         Visibility="Collapsed">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="AvatarImageBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Border Background="#DCFCE7"
                                            CornerRadius="6"
                                            Padding="8,2"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="● SESSÃO ATIVA"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="#166534"/>
                                    </Border>

                                    <Border Background="#FFFFFF"
                                            BorderBrush="#86EFAC"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,2">
                                        <TextBlock x:Name="TxtActiveDuration"
                                                   Text="Duração: 00:00:00"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#166534"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="TxtActiveTechName"
                                           Text="Técnico de Suporte"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#064E3B"
                                           Margin="0,1,0,2"/>

                                <TextBlock Text="Técnico conectado e interagindo com este computador com segurança."
                                           FontSize="12"
                                           Foreground="#047857"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Direita: Ações de Chat e Encerramento -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <Button x:Name="BtnActiveOpenChat"
                                    Content="Abrir Chat"
                                    Style="{StaticResource SoftIndigoButtonStyle}"
                                    Height="38"
                                    Padding="16,0"
                                    Margin="0,0,10,0"
                                    Click="BtnOpenChat_Click"/>

                            <Button x:Name="BtnActiveEndSession"
                                    Content="Encerrar Acesso"
                                    Style="{StaticResource DangerSolidButtonStyle}"
                                    Height="38"
                                    Padding="16,0"
                                    Click="BtnActiveEndSession_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GRID DOS DOIS CARDS PRINCIPAIS -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ============================================== -->
                    <!-- CARD 1 (ESQUERDA): PERMITIR CONTROLE REMOTO   -->
                    <!-- ============================================== -->
                    <Border Grid.Column="0"
                            Style="{StaticResource ElevatedCardBorderStyle}"
                            Padding="28,26">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Topo / Cabeçalho do Card -->
                                <RowDefinition Height="Auto"/> <!-- Display do ID -->
                                <RowDefinition Height="Auto"/> <!-- Ações do Host -->
                                <RowDefinition Height="*"/>    <!-- Guia de Segurança e Privacidade -->
                            </Grid.RowDefinitions>

                            <!-- Topo: Ícone + Título + Status -->
                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="46" Height="46"
                                        CornerRadius="12"
                                        Background="#EEF2FF"
                                        Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8B9;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="#4F46E5"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Permitir Controle Remoto"
                                               FontSize="17.5"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Informe seu código para que o técnico possa prestar suporte."
                                               FontSize="12"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <!-- Display Destacado do ID -->
                            <Border Grid.Row="1"
                                    Background="#F8FAFC"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20,16"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="SEU ID DE ACESSO REMOTO"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#64748B"
                                               Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1"
                                               x:Name="TxtHostId"
                                               Text="--- --- ---"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Foreground="#4F46E5"
                                               FontFamily="Segoe UI"/>
                                </Grid>
                            </Border>

                            <!-- Linha de Ações: Botão Copiar ID + Feedback + Ações de Sessão -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,22">
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnCopyBoth"
                                            Style="{StaticResource PrimaryIndigoButtonStyle}"
                                            Height="42"
                                            Padding="18,0"
                                            Margin="0,0,10,8"
                                            Click="BtnCopyBoth_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8C8;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="15"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Copiar ID"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnHostOpenChat"
                                            Content="Abrir Chat"
                                            Style="{StaticResource SoftIndigoButtonStyle}"
                                            Height="42"
                                            Padding="16,0"
                                            Margin="0,0,10,8"
                                            Visibility="Collapsed"
                                            Click="BtnOpenChat_Click"/>

                                    <Button x:Name="BtnHostDisconnect"
                                            Content="Encerrar Sessão"
                                            Style="{StaticResource SoftDangerButtonStyle}"
                                            Height="42"
                                            Padding="16,0"
                                            Margin="0,0,0,8"
                                            Visibility="Collapsed"
                                            Click="BtnHostDisconnect_Click"/>
                                </WrapPanel>

                                <!-- Mensagem de feedback de cópia com checkmark verde -->
                                <Border x:Name="TxtCopyFeedbackBorder"
                                        Background="#DCFCE7"
                                        BorderBrush="#86EFAC"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="#16A34A"
                                                   FontWeight="Bold"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtCopyFeedback"
                                                   Text="ID de acesso copiado!"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#166534"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Bloco Informativo de Segurança e Privacidade -->
                            <Border Grid.Row="3"
                                    Background="#F1F5F9"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14"
                                    VerticalAlignment="Bottom">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xEA18;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="#4F46E5"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Segurança e Controle Total"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="#1E293B"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="• O técnico só poderá se conectar após você aceitar expressamente na tela."
                                               FontSize="11.5"
                                               Foreground="#475569"
                                               Margin="0,0,0,4"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="• Você acompanha todas as ações e pode encerrar a conexão a qualquer segundo."
                                               FontSize="11.5"
                                               Foreground="#475569"
                                               Margin="0,0,0,4"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="• Sessão criptografada de ponta a ponta para proteger seus dados."
                                               FontSize="11.5"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Elementos de compatibilidade preservados invisíveis -->
                            <TextBlock x:Name="TxtUnattendedStatus" Visibility="Collapsed"/>
                            <PasswordBox x:Name="PwdHostUnattended" Visibility="Collapsed"/>
                            <TextBox x:Name="TxtHostUnattendedRevealed" Visibility="Collapsed"/>
                            <Button x:Name="BtnSaveUnattended" Visibility="Collapsed"/>
                            <Button x:Name="BtnToggleHostUnattendedEye" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtHostPassword" Visibility="Collapsed"/>
                            <Button x:Name="BtnNewPassword" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- ============================================== -->
                    <!-- CARD 2 (DIREITA): REALIZAR ACESSO REMOTO      -->
                    <!-- ============================================== -->
                    <Border Grid.Column="2"
                            Style="{StaticResource ElevatedCardBorderStyle}"
                            Padding="28,26">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Topo / Cabeçalho do Card -->
                                <RowDefinition Height="Auto"/> <!-- Input ID do Computador -->
                                <RowDefinition Height="Auto"/> <!-- Input Senha Opcional -->
                                <RowDefinition Height="Auto"/> <!-- Botão Conectar -->
                                <RowDefinition Height="*"/>    <!-- Guia Prático de Conexão -->
                            </Grid.RowDefinitions>

                            <!-- Topo: Ícone + Título + Subtítulo -->
                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="46" Height="46"
                                        CornerRadius="12"
                                        Background="#DCFCE7"
                                        Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="20"
                                               Foreground="#16A34A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Realizar Acesso Remoto"
                                               FontSize="17.5"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Conecte-se a outro computador para prestar assistência técnica."
                                               FontSize="12"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <!-- Campo 1: ID do Computador Remoto -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                <TextBlock Text="ID DO COMPUTADOR REMOTO"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           Margin="0,0,0,6"/>

                                <Border Height="44"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1.5"
                                        CornerRadius="10">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE7F4;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="TxtConnectTargetId"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     FontSize="18"
                                                     FontWeight="Bold"
                                                     Foreground="#4F46E5"
                                                     MaxLength="14"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="TxtConnectTargetId_KeyDown"
                                                     TextChanged="TxtConnectTargetId_TextChanged"/>

                                            <TextBlock x:Name="HintConnectTargetId"
                                                       Text="Ex: 123 456 789"
                                                       IsHitTestVisible="False"
                                                       FontSize="15"
                                                       FontWeight="Normal"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Campo 2: Senha de Acesso (Opcional - Requer Login GLPI) -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                                <TextBlock Text="SENHA DE ACESSO (OPCIONAL)"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           Margin="0,0,0,6"/>

                                <Border x:Name="BorderConnectPassword"
                                        Height="44"
                                        Background="#F8FAFC"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        ToolTip="Faça login para desbloquear"
                                        ToolTipService.ShowOnDisabled="True"
                                        PreviewMouseLeftButtonDown="BorderConnectPassword_PreviewMouseLeftButtonDown">
                                    <Grid Margin="12,0,4,0"
                                          ToolTip="Faça login para desbloquear"
                                          ToolTipService.ShowOnDisabled="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE8D7;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <Grid Grid.Column="1"
                                              ToolTip="Faça login para desbloquear"
                                              ToolTipService.ShowOnDisabled="True">
                                            <PasswordBox x:Name="PwdConnectPassword"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         FontSize="16"
                                                         FontWeight="Bold"
                                                         Foreground="#0F172A"
                                                         MaxLength="32"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="Faça login para desbloquear"
                                                         ToolTipService.ShowOnDisabled="True"
                                                         KeyDown="ConnectPassword_KeyDown"
                                                         PasswordChanged="PwdConnectPassword_PasswordChanged"/>

                                            <TextBox x:Name="TxtConnectPasswordRevealed"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     FontSize="16"
                                                     FontWeight="Bold"
                                                     Foreground="#0F172A"
                                                     MaxLength="32"
                                                     VerticalContentAlignment="Center"
                                                     Visibility="Collapsed"
                                                     ToolTip="Faça login para desbloquear"
                                                     ToolTipService.ShowOnDisabled="True"
                                                     KeyDown="ConnectPassword_KeyDown"
                                                     TextChanged="TxtConnectPasswordRevealed_TextChanged"/>

                                            <TextBlock x:Name="HintConnectPassword"
                                                       Text="Opcional para máquinas com senha fixa"
                                                       IsHitTestVisible="False"
                                                       FontSize="14"
                                                       FontWeight="Normal"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <Button Grid.Column="2"
                                                x:Name="BtnToggleEye"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Width="36"
                                                Height="36"
                                                Cursor="Hand"
                                                ToolTip="Mostrar/Ocultar Senha"
                                                Click="BtnToggleEye_Click">
                                            <TextBlock Text="&#xE7B3;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="15"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Botão Conectar e Mensagem de Erro -->
                            <StackPanel Grid.Row="3" Margin="0,0,0,22">
                                <Button x:Name="BtnConnectToRemote"
                                        Style="{StaticResource PrimaryIndigoButtonStyle}"
                                        Height="44"
                                        HorizontalAlignment="Left"
                                        Padding="22,0"
                                        Click="BtnConnectToRemote_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Conectar ao Computador"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE72A;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock x:Name="TxtConnectError"
                                           Text=""
                                           FontSize="12"
                                           Foreground="#DC2626"
                                           Margin="0,8,0,0"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Guia Prático de Conexão -->
                            <Border Grid.Row="4"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14"
                                    VerticalAlignment="Bottom">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="#16A34A"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Instruções de Atendimento"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="#1E293B"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="• Solicite o ID de 9 dígitos exibido na tela do usuário remoto."
                                               FontSize="11.5"
                                               Foreground="#475569"
                                               Margin="0,0,0,4"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="• Digite o código e clique em Conectar para enviar o pedido de sessão."
                                               FontSize="11.5"
                                               Foreground="#475569"
                                               Margin="0,0,0,4"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="• Se a máquina remota possuir acesso não supervisionado, insira a senha."
                                               FontSize="11.5"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
