<Window x:Class="SistecHub.Modulos.AcessoRemoto.AcessoRemotoPromptForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solicitação de Acesso Remoto"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#6366F1"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermIcon" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource Theme.StrongBg}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                     From="0.94" To="1" Duration="0:0:0.26">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                     From="0.94" To="1" Duration="0:0:0.26">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity"
                                     From="0.55" To="0" Duration="0:0:1.6" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.35" Duration="0:0:1.6" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.35" Duration="0:0:1.6" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="24">
        <Border x:Name="Card" CornerRadius="22" Padding="30,28,30,26"
                Background="{DynamicResource Theme.CardBg}"
                BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="1"
                RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.28" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- Cabeçalho -->
                <TextBlock Text="SOLICITAÇÃO DE ACESSO REMOTO" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                           Margin="0,0,0,22"/>

                <!-- Avatar -->
                <Grid Width="116" Height="116" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Ellipse x:Name="PulseRing" Stroke="{StaticResource Accent}" StrokeThickness="2"
                             RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PulseScale"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Margin="6" StrokeThickness="3" Stroke="{DynamicResource Theme.BorderStrong}">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="AvatarImage" Margin="9" Visibility="Collapsed"/>
                    <TextBlock x:Name="AvatarInitials" Text="TS" FontSize="34" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Width="26" Height="26" CornerRadius="13" Background="#10B981"
                            BorderBrush="{DynamicResource Theme.BorderSubtle}" BorderThickness="3"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"/>
                </Grid>

                <!-- Nome -->
                <TextBlock x:Name="LblName" Text="Técnico de Suporte" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource Theme.TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Sistec Consultoria • Suporte técnico" FontSize="12.5"
                           Foreground="{DynamicResource Theme.TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,16"/>

                <TextBlock Text="deseja acessar e controlar este computador."
                           FontSize="14" Foreground="{DynamicResource Theme.TextBody}" HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>

                <!-- Permissões -->
                <Border CornerRadius="14" Background="{DynamicResource Theme.SurfaceBg}" BorderBrush="{DynamicResource Theme.BorderSubtle}"
                        BorderThickness="1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="O QUE SERÁ PERMITIDO" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource PermIcon}">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Visualizar sua tela" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                                <TextBlock Text="Em tempo real, incluindo todos os monitores" FontSize="11.5" Foreground="{DynamicResource Theme.TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource PermIcon}">
                                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Controlar mouse e teclado" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                                <TextBlock Text="Executar ações como se estivesse no computador" FontSize="11.5" Foreground="{DynamicResource Theme.TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PermIcon}">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Transferir arquivos" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                                <TextBlock Text="Enviar e receber arquivos para o suporte" FontSize="11.5" Foreground="{DynamicResource Theme.TextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Contagem regressiva -->
                <Grid Margin="0,18,0,0">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource Theme.StrongBg}"/>
                    <Border x:Name="BarFill" Height="4" CornerRadius="2" HorizontalAlignment="Left"
                            RenderTransformOrigin="0,0.5" Background="{StaticResource Accent}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BarScale" ScaleX="1"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="LblTimer" Text="Recusa automática em 45s" FontSize="11.5"
                           Foreground="{DynamicResource Theme.TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,18"/>

                <!-- Botões -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnReject" Grid.Column="0" Content="Recusar" Click="BtnReject_Click"
                            Style="{StaticResource ActionButton}" Background="{DynamicResource Theme.DangerSoftBg}"
                            BorderBrush="{DynamicResource Theme.DangerSoftBorder}" BorderThickness="1" Foreground="{DynamicResource Theme.DangerText}"/>
                    <Button x:Name="BtnAccept" Grid.Column="2" Content="Permitir acesso" Click="BtnAccept_Click"
                            Style="{StaticResource ActionButton}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </Grid>

                <TextBlock Text="Você pode encerrar a sessão a qualquer momento pelo chat."
                           FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

