<UserControl x:Class="SistecHub.Modulos.AcessoRemoto.AcessoRemotoChatWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <!-- Estilo Botão Enviar Indigo -->
        <Style x:Key="PrimarySendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botão Pastel Encerrar -->
        <Style x:Key="SoftDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Linha 0: Cabeçalho com Avatar, Técnico e Ping -->
            <RowDefinition Height="Auto"/>
            <!-- Linha 1: Histórico de Conversa -->
            <RowDefinition Height="*"/>
            <!-- Linha 2: Barra de Entrada e Envio -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho Executivo do Atendimento -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.05" Color="#0F172A"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Avatar Circular -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Nome, Cargo e Ping -->
                    <ColumnDefinition Width="*"/>
                    <!-- Botão Encerrar -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar Circular com Ponto de Status -->
                <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center">
                    <!-- Fundo Gradiente para Iniciais -->
                    <Border CornerRadius="22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#4338CA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="TxtAvatarInitials"
                                   Text="TC"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Foto de Perfil (se configurada) -->
                    <Ellipse x:Name="AvatarImage"
                             Width="44"
                             Height="44"
                             Visibility="Collapsed"/>

                    <!-- Ponto de Status Verde (Online) com Borda Branca -->
                    <Border Width="13"
                            Height="13"
                            CornerRadius="6.5"
                            Background="#FFFFFF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,-1,-1">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#10B981"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Informações do Técnico e Ping -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtTechName"
                               Text="Técnico de Suporte"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <!-- Badge de Ping em Tempo Real -->
                        <Border x:Name="PingBadge"
                                Background="#ECFDF5"
                                BorderBrush="#A7F3D0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6,1"
                                ToolTip="Latência da conexão em tempo real">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="PingDot" Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPingValue"
                                           Text="-- ms"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="#059669"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Botão Encerrar Sessão -->
                <Button x:Name="BtnDisconnect"
                        Grid.Column="2"
                        Click="BtnDisconnect_Click"
                        Style="{StaticResource SoftDangerButtonStyle}"
                        VerticalAlignment="Center"
                        ToolTip="Encerrar o atendimento remoto">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 18.36,6.64 A 9,9 0 1 1 5.64,6.64 M 12,2 V 12"
                              Stroke="#B91C1C" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Encerrar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Histórico de Chat -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,8"
                Margin="0,0,0,10">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChatItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,6">
                                <!-- Mensagem de Sistema / Evento -->
                                <Border Background="#F1F5F9"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding SystemEventVisibility}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 12,22 C 6.5,22 2,17.5 2,12 C 2,6.5 6.5,2 12,2 C 17.5,2 22,6.5 22,12 C 22,17.5 17.5,22 12,22 Z M 12,8 V 12 M 12,16 H 12.01"
                                              Stroke="#64748B" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FormattedText}"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bolha de Chat (Mensagem de Usuário ou Técnico) -->
                                <Border Background="{Binding BubbleBackground}"
                                        BorderBrush="{Binding BubbleBorderBrush}"
                                        BorderThickness="{Binding BubbleBorderThickness}"
                                        CornerRadius="{Binding BubbleCornerRadius}"
                                        Padding="12,8"
                                        MaxWidth="290"
                                        HorizontalAlignment="{Binding BubbleAlignment}"
                                        Visibility="{Binding MessageVisibility}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="{Binding ShadowOpacity}" Color="#0F172A"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{Binding HeaderText}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding SenderForeground}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Time}"
                                                       FontSize="10"
                                                       Foreground="{Binding TimeForeground}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="12.5"
                                                   Foreground="{Binding TextForeground}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Barra de Entrada e Envio -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="6"
                Margin="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0F172A"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="6,0,8,0">
                    <TextBox x:Name="TxtChatInput"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4,4"
                             FontSize="13"
                             Foreground="#0F172A"
                             VerticalContentAlignment="Center"
                             KeyDown="TxtChatInput_KeyDown"
                             TextChanged="TxtChatInput_TextChanged"/>

                    <TextBlock x:Name="HintChatInput"
                               Text="Digite sua mensagem... (Enter para enviar)"
                               IsHitTestVisible="False"
                               Margin="4,0,0,0"
                               FontSize="12.5"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                </Grid>

                <Button x:Name="BtnSend"
                        Grid.Column="1"
                        Style="{StaticResource PrimarySendButtonStyle}"
                        Click="BtnSend_Click"
                        ToolTip="Enviar mensagem (Enter)">
                    <Path Data="M 22,2 L 11,13 M 22,2 L 15,22 L 11,13 L 2,9 Z"
                          Stroke="#FFFFFF"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
