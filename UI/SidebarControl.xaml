<UserControl x:Class="SistecHub.UI.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SidebarBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#0C1220"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="DividerStrongBrush" Color="#334155"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#818CF8"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

        <!-- Estilo de botão de navegação da Sidebar -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25344D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#312E81"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SidebarBg}"
            BorderBrush="{StaticResource DividerStrongBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="88"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho com Logo -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBg}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,14">
                <Grid>
                    <Image x:Name="ImgLogo"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtBrandFallback"
                               Text="SistecHub"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                                Margin="4,0,0,0"/>
                </Grid>
            </Border>

            <!-- Legenda NAVEGAÇÃO -->
            <TextBlock Grid.Row="1"
                       Text="NAVEGAÇÃO"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="20,16,16,8"/>

            <!-- Lista de Módulos -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,0,12,12">
                <StackPanel x:Name="NavItemsPanel"/>
            </ScrollViewer>

            <!-- Rodapé: Entidade + Configurações -->
            <Border Grid.Row="3"
                    Background="{StaticResource SidebarBg}"
                    Padding="12,10,12,14">
                <StackPanel>
                    <Border Height="1"
                            Background="{StaticResource DividerStrongBrush}"
                            Margin="4,0,4,12"/>

                    <!-- Badge da Entidade -->
                    <Border x:Name="EntityBadge"
                            Height="44"
                            CornerRadius="10"
                            Background="#162033"
                            BorderBrush="#22304A"
                            BorderThickness="1"
                            Margin="0,0,0,6"
                            Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="#818CF8"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtEntityName"
                                       Grid.Column="1"
                                       Text=""
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#E2E8F0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- Botão Configurações -->
                    <Button x:Name="BtnSettings"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="0"
                            Click="BtnSettings_Click">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SettingsActiveBar"
                                    Grid.Column="0"
                                    Width="4"
                                    Height="20"
                                    CornerRadius="2"
                                    Background="#6366F1"
                                    Margin="6,0,6,0"
                                    Visibility="Hidden"/>
                            <TextBlock x:Name="SettingsIcon"
                                       Grid.Column="1"
                                       Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SettingsLabel"
                                       Grid.Column="2"
                                       Text="Configurações"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="#CBD5E1"
                                       VerticalAlignment="Center"
                                       Margin="4,0,12,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

