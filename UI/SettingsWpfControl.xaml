<UserControl x:Class="SistecHub.UI.SettingsWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Botão Primário Indigo -->
        <Style x:Key="PrimaryIndigoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Outline Indigo -->
        <Style x:Key="OutlineIndigoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#6366F1"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Secundário Neutro -->
        <Style x:Key="NeutralRoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Pastel Vermelho (Remover foto) -->
        <Style x:Key="SoftDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borda de campo de entrada -->
        <Style x:Key="InputFieldBorderStyle" TargetType="Border">
            
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="24,20"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.03"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#0F172A"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>
            <Style x:Key="SectionDescStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ScrollViewer.Resources>

        <Grid Margin="40,32,40,36">
            <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

                <!-- Cabeçalho -->
                <TextBlock Text="Configurações"
                           FontSize="26.5"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Margin="0,0,0,6"/>
                <Border Width="56"
                        Height="4"
                        CornerRadius="2"
                        Background="#6366F1"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"/>
                <TextBlock Text="Gerencie atualizações, integração com o GLPI, acesso remoto e preferências do aplicativo."
                           FontSize="12.5"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,0,0,22"/>

                <!-- Seção: Aplicativo e atualizações -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Aplicativo e atualizações"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Background="#EEF2FF"
                                    CornerRadius="6"
                                    Padding="10,3">
                                <TextBlock x:Name="TxtVersion"
                                           Text="Versão: —"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#4F46E5"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TxtUpdateStatus"
                                   Text=""
                                   FontSize="12.5"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <TextBlock x:Name="TxtUpdateUnsupported"
                                   Text="Atualizações indisponíveis — use a instalação MSI."
                                   FontSize="11.5"
                                   Foreground="#64748B"
                                   Margin="0,0,0,14"
                                   Visibility="Collapsed"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnCheckUpdate"
                                    Content="Verificar atualizações"
                                    Style="{StaticResource PrimaryIndigoButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="BtnCheckUpdate_Click"/>
                            <Button x:Name="BtnCheckBetaUpdate"
                                    Content="Verificar atualização Beta"
                                    Style="{StaticResource OutlineIndigoButtonStyle}"
                                    Click="BtnCheckBetaUpdate_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Seção: Integração GLPI -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Integração GLPI"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Credenciais e identificação desta máquina no sistema de chamados e inventário."
                                   Style="{StaticResource SectionDescStyle}"/>

                        <TextBlock Text="User token" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource InputFieldBorderStyle}" Margin="0,0,0,16">
                            <PasswordBox x:Name="PwdGlpiUserToken"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="10,0"
                                         FontSize="13.5"
                                         Foreground="#0F172A"
                                         VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Entidade" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbEntity"
                                  Height="36"
                                  HorizontalAlignment="Stretch"
                                  FontSize="13.5"
                                  Foreground="#0F172A"
                                  Background="#FFFFFF"
                                  BorderBrush="#CBD5E1"
                                  VerticalContentAlignment="Center"
                                  MaxDropDownHeight="360"
                                  Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="ID da máquina (plugin Inventário)"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <Border Background="Transparent"
                                    Cursor="Hand"
                                    Padding="2"
                                    VerticalAlignment="Center"
                                    ToolTip="Clique para bloquear/desbloquear a edição"
                                    MouseLeftButtonUp="MachineIdLock_MouseLeftButtonUp">
                                <TextBlock x:Name="TxtMachineIdLockGlyph"
                                           Text="&#xE72E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="#6366F1"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <Border x:Name="BdGlpiMachineId"
                                Style="{StaticResource InputFieldBorderStyle}"
                                Background="#F1F5F9">
                            <TextBox x:Name="TxtGlpiMachineId"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="10,0"
                                     FontSize="13.5"
                                     Foreground="#0F172A"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Seção: Acesso remoto -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Acesso remoto"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Servidor de conexão e relay do acesso remoto."
                                   Style="{StaticResource SectionDescStyle}"/>

                        <TextBlock Text="Servidor de acesso WSS" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource InputFieldBorderStyle}">
                            <Grid>
                                <TextBox x:Name="TxtRemotoServerUrl"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="10,0"
                                         FontSize="13.5"
                                         Foreground="#0F172A"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtRemotoServerUrl_TextChanged"/>
                                <TextBlock x:Name="HintRemotoServerUrl"
                                           Text=""
                                           IsHitTestVisible="False"
                                           Margin="12,0,10,0"
                                           FontSize="13"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Bloqueio do Acesso Remoto nesta Máquina -->
                        <Border Margin="0,18,0,0"
                                Padding="16,14"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="Bloquear acesso remoto nessa máquina"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center"/>
                                        <Border x:Name="BdBloqueioBadge"
                                                CornerRadius="5"
                                                Padding="8,2"
                                                Margin="10,0,0,0"
                                                Background="#DCFCE7"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtBloqueioBadge"
                                                       Text="LIBERADO"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#16A34A"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtBloqueioDesc"
                                               Text="Desabilita o sistema de acesso remoto do SistecHUB neste computador e impede conexões de suporte."
                                               FontSize="12"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        x:Name="BtnToggleBloqueioRemoto"
                                        Content="Bloquear acesso remoto nessa máquina"
                                        Style="{StaticResource SoftDangerButtonStyle}"
                                        VerticalAlignment="Center"
                                        Click="BtnToggleBloqueioRemoto_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Seção: Inventário -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Inventário"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Exporte o relatório de hardware localmente ou envie-o agora ao servidor."
                                   Style="{StaticResource SectionDescStyle}"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnExportJson"
                                    Content="Exportar relatório JSON"
                                    Style="{StaticResource PrimaryIndigoButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="BtnExportJson_Click"/>
                            <Button x:Name="BtnEnviarInventario"
                                    Content="Enviar inventário ao servidor"
                                    Style="{StaticResource OutlineIndigoButtonStyle}"
                                    Click="BtnEnviarInventario_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Seção: Preferências -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Preferências"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Comportamento do SistecHub ao iniciar com o Windows."
                                   Style="{StaticResource SectionDescStyle}"/>

                        <CheckBox x:Name="ChkIniciarMinimizado"
                                  Content="Iniciar em segundo plano"
                                  FontSize="13.5"
                                  Foreground="#0F172A"
                                  Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Rodapé: Salvar -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="BtnSave"
                            Content="Salvar configurações"
                            Style="{StaticResource PrimaryIndigoButtonStyle}"
                            Click="BtnSave_Click"/>
                    <TextBlock x:Name="TxtFeedback"
                               Text=""
                               FontSize="13"
                               Foreground="#16A34A"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
