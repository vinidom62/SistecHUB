<UserControl x:Class="SistecHub.UI.ServiceStartupWaitWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Theme.PageBg}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtMessage"
                   Grid.Row="0"
                   Text="A aplicar atualização, aguarde o serviço reiniciar..."
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Theme.TextPrimary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="4"
                     Foreground="#6366F1"
                     Background="{DynamicResource Theme.StrongBg}"
                     BorderThickness="0"
                     Margin="0,0,0,16"/>

        <TextBlock x:Name="TxtCountdown"
                   Grid.Row="2"
                   Text=""
                   FontSize="13"
                   Foreground="#6366F1"
                   FontWeight="SemiBold"/>
    </Grid>
</UserControl>

