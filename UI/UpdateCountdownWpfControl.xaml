<UserControl x:Class="SistecHub.UI.UpdateCountdownWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle"
                   Grid.Row="0"
                   Text="Versão pronta para instalar"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="O SistecHub irá reiniciar automaticamente para aplicar a atualização."
                   FontSize="13"
                   Foreground="#64748B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <TextBlock x:Name="TxtCountdown"
                   Grid.Row="2"
                   Text=""
                   FontSize="13.5"
                   FontWeight="SemiBold"
                   Foreground="#6366F1"/>
    </Grid>
</UserControl>

