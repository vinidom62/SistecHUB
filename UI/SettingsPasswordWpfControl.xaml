<UserControl x:Class="SistecHub.UI.SettingsPasswordWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Theme.PageBg}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="PrimaryIndigoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelRoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.StrongBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.PressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="32,26,32,26">
        <TextBlock x:Name="TxtTitle"
                   Text="Senha necessária"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Theme.TextPrimary}"
                   Margin="0,0,0,6"/>

        <TextBlock x:Name="TxtSubtitle"
                   Text="Digite a senha para abrir as configurações."
                   FontSize="13"
                   Foreground="{DynamicResource Theme.TextMuted}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Senha"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Theme.TextPrimary}"
                   Margin="0,0,0,6"/>

        <Border Background="{DynamicResource Theme.CardBg}"
                BorderBrush="{DynamicResource Theme.BorderStrong}"
                BorderThickness="1"
                CornerRadius="8"
                Height="36">
            <PasswordBox x:Name="PwdBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,0"
                         FontSize="13.5"
                         Foreground="{DynamicResource Theme.TextPrimary}"
                         VerticalContentAlignment="Center"
                         KeyDown="PwdBox_KeyDown"/>
        </Border>

        <TextBlock x:Name="TxtError"
                   Text="Senha incorreta."
                   FontSize="12.5"
                   Foreground="{DynamicResource Theme.DangerText}"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="Entrar"
                    Style="{StaticResource PrimaryIndigoButtonStyle}"
                    Margin="0,0,8,0"
                    Click="BtnConfirm_Click"/>

            <Button Content="Cancelar"
                    Style="{StaticResource CancelRoundedButtonStyle}"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>

