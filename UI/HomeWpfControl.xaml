<UserControl x:Class="SistecHub.UI.HomeWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Estilo do Card de Acesso Remoto (Hover Índigo) -->
        <Style x:Key="RemoteCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Shadow" Color="#0F172A" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FAFAFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Card de Chamados (Hover Verde Esmeralda) -->
        <Style x:Key="TicketCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.04"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FAFCFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="680"
                        Margin="36,40">

                <!-- Linha de detalhe elegante em índigo -->
                <Border Width="40"
                        Height="4"
                        CornerRadius="2"
                        Background="#6366F1"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,18"/>

                <!-- Saudação dinâmica: "Bom dia, [Nome]!" -->
                <TextBlock x:Name="TxtGreeting"
                           Text="Olá"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Margin="0,0,0,6"/>

                <!-- Subtítulo sutil -->
                <TextBlock Text="O que você precisa fazer agora? Utilize os atalhos rápidos ou navegue pelo menu lateral:"
                           FontSize="13.5"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,0,0,26"/>

                <!-- Grid dos 2 Botões de Ação Rápida -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1: ABRIR CHAMADO -->
                    <Button Grid.Column="0"
                            Style="{StaticResource TicketCardButtonStyle}"
                            Click="BtnOpenTicket_Click"
                            ToolTip="Clique para abrir uma nova solicitação de chamado no GLPI">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Topo: Ícone e Tag -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Border Width="46" Height="46"
                                        CornerRadius="12"
                                        Background="#DCFCE7"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE8BD;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="#16A34A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="#F1F5F9"
                                        CornerRadius="6"
                                        Padding="8,3">
                                    <TextBlock Text="SUPORTE TI"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#64748B"/>
                                </Border>
                            </Grid>

                            <!-- Título -->
                            <TextBlock Grid.Row="1"
                                       Text="Abrir Chamado"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,6"/>

                            <!-- Descrição -->
                            <TextBlock Grid.Row="2"
                                       Text="Abra uma solicitação de assistência ou relate uma falha técnica para a equipe de TI."
                                       FontSize="12.5"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,0,0,18"/>

                            <!-- Ação / Link -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Criar solicitação"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#16A34A"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="&#xE72A;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="#16A34A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 2: COPIAR (E ABRIR) ACESSO REMOTO -->
                    <Button Grid.Column="2"
                            x:Name="BtnCopyAndOpenRemote"
                            Style="{StaticResource RemoteCardButtonStyle}"
                            Click="BtnCopyAndOpenRemote_Click"
                            ToolTip="Clique para copiar seu ID e abrir o módulo de Acesso Remoto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Topo: Ícone e Badge com ID -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Border x:Name="BdRemoteIcon"
                                        Width="46" Height="46"
                                        CornerRadius="12"
                                        Background="#EEF2FF"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="IconRemoteCard"
                                               Text="&#xE7F4;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="#6366F1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <Border x:Name="BdQuickIdBadge"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="#EEF2FF"
                                        CornerRadius="6"
                                        Padding="8,3">
                                    <TextBlock x:Name="TxtQuickIdBadge"
                                               Text="ACESSO REMOTO"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#4F46E5"/>
                                </Border>
                            </Grid>

                            <!-- Título -->
                            <TextBlock Grid.Row="1"
                                       Text="Acesso Remoto"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,6"/>

                            <!-- Descrição -->
                            <TextBlock Grid.Row="2"
                                       Text="Copia o ID deste computador e abre imediatamente a tela de conexão para atendimento."
                                       FontSize="12.5"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,0,0,18"/>

                            <!-- Ação / Link -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtRemoteActionText"
                                           Text="Copiar ID e abrir tela"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#4F46E5"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="IconRemoteActionArrow"
                                           Text="&#xE72A;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="#4F46E5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Dica sutil no rodapé -->
                <TextBlock Text="Dica: O ID de acesso remoto também pode ser consultado a qualquer momento no menu lateral."
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           Margin="0,22,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
