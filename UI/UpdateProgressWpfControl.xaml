<UserControl x:Class="SistecHub.UI.UpdateProgressWpfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="PrimaryIndigoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryNeutralButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Margin="16"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho com ícone e título -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="BdIconBadge"
                        Grid.Column="0"
                        Width="38"
                        Height="38"
                        CornerRadius="10"
                        Background="#EEF2FF"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIconGlyph"
                               Text="&#xE895;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="#4F46E5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="IconRotateTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="Verificando atualizações"
                               FontSize="16.5"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock x:Name="TxtSubtitle"
                               Text="SistecHub Update"
                               FontSize="11.5"
                               Foreground="#64748B"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Mensagem principal -->
            <TextBlock x:Name="TxtMessage"
                       Grid.Row="1"
                       Text="Verificando se há atualizações disponíveis no servidor..."
                       FontSize="13"
                       Foreground="#334155"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       Margin="0,0,0,14"/>

            <!-- Área de barra de progresso e indicador percentual / contagem -->
            <StackPanel x:Name="PnlProgressSection"
                        Grid.Row="2"
                        Margin="0,0,0,12">
                <ProgressBar x:Name="BarProgress"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             IsIndeterminate="True"
                             Foreground="#6366F1"
                             Background="#E2E8F0"
                             BorderThickness="0"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtProgressHint"
                               Grid.Column="0"
                               Text="Aguarde um instante..."
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#6366F1"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="TxtPercent"
                               Grid.Column="1"
                               Text=""
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#4F46E5"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </StackPanel>

            <Border Grid.Row="3"/>

            <!-- Rodapé de ações (Reiniciar Agora / Tentar Novamente / Ver Logs / Fechar) -->
            <StackPanel x:Name="PnlActions"
                        Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,6,0,0"
                        Visibility="Collapsed">
                <Button x:Name="BtnViewLogs"
                        Content="Ver Logs"
                        Style="{StaticResource SecondaryNeutralButtonStyle}"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="BtnViewLogs_Click"/>
                <Button x:Name="BtnRetry"
                        Content="Tentar Novamente"
                        Style="{StaticResource PrimaryIndigoButtonStyle}"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="BtnRetry_Click"/>
                <Button x:Name="BtnClose"
                        Content="Fechar"
                        Style="{StaticResource SecondaryNeutralButtonStyle}"
                        Visibility="Collapsed"
                        Click="BtnClose_Click"/>
                <Button x:Name="BtnRestartNow"
                        Content="Reiniciar Agora"
                        Style="{StaticResource PrimaryIndigoButtonStyle}"
                        Visibility="Collapsed"
                        Click="BtnRestartNow_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
